# ==============================================================================
# JobCheck - Backend Environment Configuration Template
# Copy this file to a new file named '.env' and populate with actual credentials.
# Note: Do NOT commit your actual '.env' file to Git repositories.
# ==============================================================================

# Flask Configuration
# A secure, random secret key for signing session cookies
SECRET_KEY=dev-super-secret-key-change-in-prod

# JWT Configuration
# A secure secret key for signing JWT tokens used by the prediction API
JWT_SECRET_KEY=jwt-secret-string-change-this
